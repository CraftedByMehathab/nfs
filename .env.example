# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (starts with sb_publishable_). The older "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
